# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml substitutes these variables at runtime.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=video_server
MYSQL_USER=video_user
DB_PASSWORD=change-me-app-password

# Application database connection
DB_HOST=mysql
DB_PORT=3306
DB_USER=video_user
DB_NAME=video_server

# Redis
REDIS_ADDR=redis:6379

# JWT signing key: at least 32 characters, the API server refuses to start without it
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Grafana admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# CORS allowlist (comma separated); defaults to http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared storage paths inside containers (must match the mounted volume)
STORAGE_VIDEO_DIR=/app/storage/videos
STORAGE_TEMP_DIR=/app/storage/temp

# Database startup retry (optional, defaults: 5 attempts / 3s)
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_DELAY=3s

# 主机端口映射（Windows/WSL2 可能保留 3000/3001，可按需覆盖）
FRONTEND_PORT=3000
GRAFANA_PORT=3001

# 播放令牌有效期（秒）；<video src> 无法携带 Authorization 头，改用短时效令牌
STREAM_TOKEN_TTL=7200

# /metrics 的 Bearer 令牌（可选）。留空时 /metrics 只允许内网/回环抓取；
# 配置后 Prometheus 需在 prometheus.yml 用 authorization.credentials_file 提供同一令牌
METRICS_TOKEN=

# Alertmanager 邮件通知：163 邮箱的 SMTP 授权码（不是登录密码）
# 获取方式：163 邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 获取授权码
ALERTMANAGER_SMTP_PASSWORD=
