# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml substitutes these variables at runtime.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=video_server
MYSQL_USER=video_user
DB_PASSWORD=change-me-app-password

# Application database connection
DB_HOST=mysql
DB_PORT=3306
DB_USER=video_user
DB_NAME=video_server

# Redis
REDIS_ADDR=redis:6379

# JWT signing key: at least 32 characters, the API server refuses to start without it
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Grafana admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# CORS allowlist (comma separated); defaults to http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Shared storage paths inside containers (must match the mounted volume)
STORAGE_VIDEO_DIR=/app/storage/videos
STORAGE_TEMP_DIR=/app/storage/temp

# Database startup retry (optional, defaults: 5 attempts / 3s)
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_DELAY=3s
DB_LOG_LEVEL=warn
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# 主机端口映射（Windows/WSL2 可能保留 3000/3001，可按需覆盖）
FRONTEND_PORT=3000
GRAFANA_PORT=3001

# 播放令牌有效期（秒）；<video src> 无法携带 Authorization 头，改用短时效令牌
STREAM_TOKEN_TTL=7200

# 上传审核与配额
VIDEO_MODERATION_REQUIRED=false
USER_VIDEO_QUOTA=100
USER_STORAGE_QUOTA_BYTES=10737418240
USER_DAILY_UPLOAD_LIMIT=20

# 受信代理；容器内前端转发时使用；生产只配置实际代理地址/私网
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# 恶意文件扫描（生产启用时需提供 clamdscan 与 clamd 服务）
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=tcp://clamav:3310

# 对象存储；local 用于本地开发，生产使用 s3（DigitalOcean Spaces）
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=nyc3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=sfo3
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# 托管数据库 TLS（生产 managed MySQL/Redis 开启）
DB_TLS_CA_PATH=
REDIS_TLS_ENABLED=false
REDIS_TLS_CA_PATH=

# /metrics 的 Bearer 令牌（可选）。留空时 /metrics 只允许内网/回环抓取；
# 配置后 Prometheus 需在 prometheus.yml 用 authorization.credentials_file 提供同一令牌
METRICS_TOKEN=

# Alertmanager 邮件通知：163 邮箱的 SMTP 授权码（不是登录密码）
# 获取方式：163 邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 获取授权码
ALERTMANAGER_SMTP_PASSWORD=
ALERT_EMAIL_TO=lixiandea@163.com

# 审计日志保留期（天）；scheduler 启动时与每小时按此清理
AUDIT_RETENTION_DAYS=30
