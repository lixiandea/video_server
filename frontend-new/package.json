{
  "name": "video-server-frontend",
  "version": "2.0.0",
  "description": "Video Server Frontend with Vue 3 and Video Player",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:unit && npm run test:e2e",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.8",
    "video.js": "^8.12.0",
    "hls.js": "^1.5.7",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^10.11.1",
    "vue-eslint-parser": "^10.4.1",
    "sass": "^1.105.2"
  },
  "keywords": [
    "video",
    "streaming",
    "vue3",
    "hls",
    "player"
  ],
  "author": "",
  "license": "MIT"
}
