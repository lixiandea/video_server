REGISTRY=ghcr.io/lixiandea
IMAGE_TAG=replace-with-commit-sha
GHCR_USERNAME=lixiandea

APP_DOMAIN=video.example.com
DB_HOST=video-server-mysql-do-user-xxxxx.db.ondigitalocean.com
DB_PORT=25060
DB_USER=video_app
DB_NAME=video_server
REDIS_ADDR=video-server-redis-do-user-xxxxx.db.ondigitalocean.com:25061

S3_ENDPOINT=https://video-server-media-nyc3.nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=video-server-media-nyc3
S3_BACKUP_ENDPOINT=https://video-server-backup-sfo3.sfo3.digitaloceanspaces.com
S3_BACKUP_REGION=sfo3
S3_BACKUP_BUCKET=video-server-backup-sfo3

ALERT_EMAIL_TO=ops@example.com
SECRETS_DIR=/opt/video-server/secrets
RCLONE_REMOTE=backup-spaces:video-server-backup-sfo3/database
RCLONE_LOG_REMOTE=backup-spaces:video-server-backup-sfo3/logs
